<Application x:Class="ParolFarm.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ParolFarm.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <local:BoolToBrushConverter x:Key="OkBrush" TrueBrush="#2E9E4F" FalseBrush="#B0B0B0" />
        <local:BoolToBrushConverter x:Key="AlarmBrush" TrueBrush="#D32F2F" FalseBrush="#B0B0B0" />
        <local:InverseBoolConverter x:Key="Not" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="MinWidth" Value="34" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Lamp" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="3,0" />
        </Style>
        <Style x:Key="LampText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="6,2" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,2,6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#555" />
        </Style>
        <Style x:Key="JogButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ClickMode" Value="Press" />
        </Style>
        <Style x:Key="HoldButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="#FFF4D6" />
        </Style>
    </Application.Resources>
</Application>
