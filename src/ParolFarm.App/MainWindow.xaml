<Window x:Class="ParolFarm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParolFarm.App"
        Title="PAROL6 Printfarm" Height="860" Width="1380" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <DockPanel>

        <!-- ===================== Kopfzeile: Verbindung & Status ===================== -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="6">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="COM-Port:" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" Width="90" VerticalAlignment="Center" />
                <Button Content="↻" ToolTip="Ports neu suchen" Command="{Binding RefreshPortsCommand}" />
                <Button Content="Verbinden" Command="{Binding ConnectCommand}" />
                <Button Content="Simulation" Command="{Binding ConnectSimulationCommand}" ToolTip="Ohne Roboter testen" />
                <Button Content="Trennen" Command="{Binding DisconnectCommand}" />
                <Separator Margin="8,2" />
                <Button Content="Referenzfahrt" Command="{Binding HomeCommand}" />
                <Button Content="Freigeben" Command="{Binding EnableCommand}" />
                <Button Content="Sperren" Command="{Binding DisableCommand}" />
                <Button Content="Fehler quittieren" Command="{Binding ClearErrorCommand}" />
                <Button Content="■ STOPP" Command="{Binding StopCommand}" Background="#FFCDD2" FontWeight="Bold" />
                <Separator Margin="8,2" />
                <Border Style="{StaticResource Lamp}" Background="{Binding FeedbackOk, Converter={StaticResource OkBrush}}">
                    <TextBlock Style="{StaticResource LampText}" Text="{Binding LinkName, StringFormat=Verbunden {0}, TargetNullValue=Verbunden}" />
                </Border>
                <Border Style="{StaticResource Lamp}" Background="{Binding Homed, Converter={StaticResource OkBrush}}">
                    <TextBlock Style="{StaticResource LampText}" Text="Referenziert" />
                </Border>
                <Border Style="{StaticResource Lamp}" Background="{Binding Enabled, Converter={StaticResource OkBrush}}">
                    <TextBlock Style="{StaticResource LampText}" Text="Freigegeben" />
                </Border>
                <Border Style="{StaticResource Lamp}" Background="{Binding EStop, Converter={StaticResource AlarmBrush}}">
                    <TextBlock Style="{StaticResource LampText}" Text="NOT-AUS" />
                </Border>
                <TextBlock Text="{Binding MotionText}" VerticalAlignment="Center" Margin="10,0" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ErrorText}" VerticalAlignment="Center" Foreground="#D32F2F" FontWeight="SemiBold" />
            </WrapPanel>
        </Border>

        <!-- ===================== Protokoll ===================== -->
        <GroupBox DockPanel.Dock="Bottom" Header="Protokoll" Height="140">
            <ListBox ItemsSource="{Binding LogLines}" FontFamily="Consolas" BorderThickness="0" />
        </GroupBox>

        <TabControl Margin="4">

            <!-- ===================== Bewegen & Teachen ===================== -->
            <TabItem Header="  Bewegen &amp; Teachen  ">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Position -->
                    <StackPanel Grid.Column="0">
                        <GroupBox Header="TCP (Basis)  –  mm / Rotationsvektor °">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="X" />
                                <TextBlock Style="{StaticResource Value}" Grid.Column="1" Text="{Binding TcpX}" />
                                <TextBlock Style="{StaticResource Label}" Grid.Column="2" Text="Rx" />
                                <TextBlock Style="{StaticResource Value}" Grid.Column="3" Text="{Binding TcpRx}" />
                                <TextBlock Style="{StaticResource Label}" Grid.Row="1" Text="Y" />
                                <TextBlock Style="{StaticResource Value}" Grid.Row="1" Grid.Column="1" Text="{Binding TcpY}" />
                                <TextBlock Style="{StaticResource Label}" Grid.Row="1" Grid.Column="2" Text="Ry" />
                                <TextBlock Style="{StaticResource Value}" Grid.Row="1" Grid.Column="3" Text="{Binding TcpRy}" />
                                <TextBlock Style="{StaticResource Label}" Grid.Row="2" Text="Z" />
                                <TextBlock Style="{StaticResource Value}" Grid.Row="2" Grid.Column="1" Text="{Binding TcpZ}" />
                                <TextBlock Style="{StaticResource Label}" Grid.Row="2" Grid.Column="2" Text="Rz" />
                                <TextBlock Style="{StaticResource Value}" Grid.Row="2" Grid.Column="3" Text="{Binding TcpRz}" />
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Gelenke (°)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="J1" />
                                <TextBlock Style="{StaticResource Value}" Grid.Column="1" Text="{Binding J1}" />
                                <TextBlock Style="{StaticResource Label}" Grid.Column="2" Text="J4" />
                                <TextBlock Style="{StaticResource Value}" Grid.Column="3" Text="{Binding J4}" />
                                <TextBlock Style="{StaticResource Label}" Grid.Row="1" Text="J2" />
                                <TextBlock Style="{StaticResource Value}" Grid.Row="1" Grid.Column="1" Text="{Binding J2}" />
                                <TextBlock Style="{StaticResource Label}" Grid.Row="1" Grid.Column="2" Text="J5" />
                                <TextBlock Style="{StaticResource Value}" Grid.Row="1" Grid.Column="3" Text="{Binding J5}" />
                                <TextBlock Style="{StaticResource Label}" Grid.Row="2" Text="J3" />
                                <TextBlock Style="{StaticResource Value}" Grid.Row="2" Grid.Column="1" Text="{Binding J3}" />
                                <TextBlock Style="{StaticResource Label}" Grid.Row="2" Grid.Column="2" Text="J6" />
                                <TextBlock Style="{StaticResource Value}" Grid.Row="2" Grid.Column="3" Text="{Binding J6}" />
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Geschwindigkeit">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SpeedOverride, StringFormat={}{0:F0} %}" Width="46" TextAlignment="Right" FontWeight="SemiBold" />
                                    <Slider Minimum="1" Maximum="100" Value="{Binding SpeedOverride}" IsSnapToTickEnabled="True" TickFrequency="1" />
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Greifer">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Greifer ZU" Command="{Binding GripperCloseCommand}" />
                                <Button Content="Greifer AUF" Command="{Binding GripperOpenCommand}" />
                                <Border Style="{StaticResource Lamp}" Background="{Binding GripperClosed, Converter={StaticResource OkBrush}}" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource LampText}" Text="zu" />
                                </Border>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <!-- Jog -->
                    <StackPanel Grid.Column="1">
                        <GroupBox Header="Jog (gedrückt halten)">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <RadioButton Content="Basis" IsChecked="{Binding ToolFrame, Converter={StaticResource Not}}" Margin="4" />
                                    <RadioButton Content="Werkzeug (TCP)" IsChecked="{Binding ToolFrame}" Margin="4" />
                                </StackPanel>
                                <UniformGrid Columns="4" x:Name="CartJog">
                                    <Button Style="{StaticResource JogButton}" Tag="X-" Content="X −" />
                                    <Button Style="{StaticResource JogButton}" Tag="X+" Content="X +" />
                                    <Button Style="{StaticResource JogButton}" Tag="Rx-" Content="Rx −" />
                                    <Button Style="{StaticResource JogButton}" Tag="Rx+" Content="Rx +" />
                                    <Button Style="{StaticResource JogButton}" Tag="Y-" Content="Y −" />
                                    <Button Style="{StaticResource JogButton}" Tag="Y+" Content="Y +" />
                                    <Button Style="{StaticResource JogButton}" Tag="Ry-" Content="Ry −" />
                                    <Button Style="{StaticResource JogButton}" Tag="Ry+" Content="Ry +" />
                                    <Button Style="{StaticResource JogButton}" Tag="Z-" Content="Z −" />
                                    <Button Style="{StaticResource JogButton}" Tag="Z+" Content="Z +" />
                                    <Button Style="{StaticResource JogButton}" Tag="Rz-" Content="Rz −" />
                                    <Button Style="{StaticResource JogButton}" Tag="Rz+" Content="Rz +" />
                                </UniformGrid>
                                <TextBlock Text="Gelenke" Margin="3,8,3,2" Foreground="#555" />
                                <UniformGrid Columns="4" x:Name="JointJog">
                                    <Button Style="{StaticResource JogButton}" Tag="J1-" Content="J1 −" />
                                    <Button Style="{StaticResource JogButton}" Tag="J1+" Content="J1 +" />
                                    <Button Style="{StaticResource JogButton}" Tag="J4-" Content="J4 −" />
                                    <Button Style="{StaticResource JogButton}" Tag="J4+" Content="J4 +" />
                                    <Button Style="{StaticResource JogButton}" Tag="J2-" Content="J2 −" />
                                    <Button Style="{StaticResource JogButton}" Tag="J2+" Content="J2 +" />
                                    <Button Style="{StaticResource JogButton}" Tag="J5-" Content="J5 −" />
                                    <Button Style="{StaticResource JogButton}" Tag="J5+" Content="J5 +" />
                                    <Button Style="{StaticResource JogButton}" Tag="J3-" Content="J3 −" />
                                    <Button Style="{StaticResource JogButton}" Tag="J3+" Content="J3 +" />
                                    <Button Style="{StaticResource JogButton}" Tag="J6-" Content="J6 −" />
                                    <Button Style="{StaticResource JogButton}" Tag="J6+" Content="J6 +" />
                                </UniformGrid>
                                <TextBlock Text="{Binding JogWarning}" Foreground="#E65100" FontWeight="SemiBold" TextWrapping="Wrap" Margin="3,6" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="SpaceMouse">
                            <StackPanel>
                                <CheckBox Content="SpaceMouse aktiv" IsChecked="{Binding SpaceMouseActive}" />
                                <TextBlock Text="{Binding SpaceMouseText}" FontFamily="Consolas" Margin="3" TextWrapping="Wrap" />
                                <TextBlock Foreground="#555" TextWrapping="Wrap" Margin="3">
                                    Linke Taste: Greifer auf/zu · Rechte Taste: Basis ↔ Werkzeug.
                                    Bewegt nur, solange dieses Fenster aktiv ist.
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <!-- Punkte -->
                    <GroupBox Grid.Column="2" Header="Punkte (Wegpunkte)">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <DockPanel>
                                    <TextBlock Text="Name:" Style="{StaticResource Label}" />
                                    <Button DockPanel.Dock="Right" Content="Umbenennen" Command="{Binding RenameWaypointCommand}" />
                                    <Button DockPanel.Dock="Right" Content="＋ Aktuelle Position speichern" Command="{Binding AddWaypointCommand}" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding NewWaypointName, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Mit aktueller Position überschreiben" Command="{Binding OverwriteWaypointCommand}" />
                                    <Button Content="Löschen" Command="{Binding DeleteWaypointCommand}" />
                                </StackPanel>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Text="Anfahrgeschwindigkeit" Style="{StaticResource Label}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding MoveSpeedPercent, StringFormat={}{0:F0} %}" Width="46" TextAlignment="Right" />
                                    <Slider Minimum="5" Maximum="100" Value="{Binding MoveSpeedPercent}" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
                                </DockPanel>
                                <UniformGrid Columns="2">
                                    <Button Style="{StaticResource HoldButton}" x:Name="HoldMoveJ" Content="Anfahren (Gelenk) – gedrückt halten" />
                                    <Button Style="{StaticResource HoldButton}" x:Name="HoldMoveL" Content="Linear anfahren – gedrückt halten" />
                                </UniformGrid>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Waypoints}" SelectedItem="{Binding SelectedWaypoint}" Margin="0,4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" FontFamily="Consolas" Foreground="#555" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ===================== Programme ===================== -->
            <TabItem Header="  Programme  ">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="Programme">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom">
                                <TextBox Text="{Binding ProgramName, UpdateSourceTrigger=PropertyChanged}" />
                                <UniformGrid Columns="3">
                                    <Button Content="Neu" Command="{Binding NewProgramCommand}" />
                                    <Button Content="Umbenennen" Command="{Binding RenameProgramCommand}" />
                                    <Button Content="Löschen" Command="{Binding DeleteProgramCommand}" />
                                </UniformGrid>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Programs}" SelectedItem="{Binding SelectedProgram}" DisplayMemberPath="Name"
                                     IsEnabled="{Binding ProgramRunning, Converter={StaticResource Not}}" />
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="Ablauf">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <Button Content="▶ Start" Command="{Binding RunProgramCommand}" FontWeight="Bold" Background="#C8E6C9" />
                                <Button Content="■ Stopp" Command="{Binding StopProgramCommand}" FontWeight="Bold" Background="#FFCDD2" />
                                <TextBlock VerticalAlignment="Center" Margin="10,0" Foreground="#555"
                                           Text="Geschwindigkeit = Schritt-Geschwindigkeit × Override (Reiter Bewegen)" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}" Margin="0,4"
                                     IsEnabled="{Binding ProgramRunning, Converter={StaticResource Not}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="▶" Foreground="#2E9E4F" Width="16" FontWeight="Bold"
                                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Number, StringFormat={}{0}.}" Width="30" Foreground="#777" />
                                            <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="14" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </GroupBox>

                    <StackPanel Grid.Column="2" IsEnabled="{Binding ProgramRunning, Converter={StaticResource Not}}">
                        <GroupBox Header="Schritt einfügen (nach Auswahl)">
                            <UniformGrid Columns="2">
                                <Button Content="MoveJ" Command="{Binding AddMoveJCommand}" ToolTip="Gelenkfahrt zum in 'Bewegen' ausgewählten Punkt" />
                                <Button Content="MoveL" Command="{Binding AddMoveLCommand}" ToolTip="Linearfahrt zum in 'Bewegen' ausgewählten Punkt" />
                                <Button Content="Greifer ZU" Command="{Binding AddGripperCloseCommand}" />
                                <Button Content="Greifer AUF" Command="{Binding AddGripperOpenCommand}" />
                                <Button Content="Warten" Command="{Binding AddWaitCommand}" />
                            </UniformGrid>
                        </GroupBox>
                        <GroupBox Header="Ausgewählter Schritt">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Punkt" />
                                <ComboBox Grid.Column="1" Margin="3" ItemsSource="{Binding WaypointNames}" SelectedItem="{Binding StepWaypoint}" />
                                <TextBlock Style="{StaticResource Label}" Grid.Row="1" Text="Geschw. (% / mm/s)" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StepSpeed}" />
                                <TextBlock Style="{StaticResource Label}" Grid.Row="2" Text="Wartezeit (ms)" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StepWaitMs}" />
                                <Button Grid.Row="3" Grid.ColumnSpan="2" Content="Übernehmen" Command="{Binding ApplyStepCommand}" />
                            </Grid>
                        </GroupBox>
                        <UniformGrid Columns="3" Margin="4">
                            <Button Content="▲ Hoch" Command="{Binding StepUpCommand}" />
                            <Button Content="▼ Runter" Command="{Binding StepDownCommand}" />
                            <Button Content="Löschen" Command="{Binding DeleteStepCommand}" />
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===================== Einstellungen ===================== -->
            <TabItem Header="  Einstellungen  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel>
                        <GroupBox Header="Werkzeug / TCP (relativ zum Flansch)" Width="330">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="3">
                                    Versatz der Greiferspitze. X, Y, Z in mm, Rx, Ry, Rz als Rotationsvektor in Grad (wie UR).
                                </TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition /><ColumnDefinition Width="40" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="X" />
                                    <TextBox Grid.Column="1" Text="{Binding ToolX}" />
                                    <TextBlock Style="{StaticResource Label}" Grid.Column="2" Text="Rx" />
                                    <TextBox Grid.Column="3" Text="{Binding ToolRx}" />
                                    <TextBlock Style="{StaticResource Label}" Grid.Row="1" Text="Y" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ToolY}" />
                                    <TextBlock Style="{StaticResource Label}" Grid.Row="1" Grid.Column="2" Text="Ry" />
                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ToolRy}" />
                                    <TextBlock Style="{StaticResource Label}" Grid.Row="2" Text="Z" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ToolZ}" />
                                    <TextBlock Style="{StaticResource Label}" Grid.Row="2" Grid.Column="2" Text="Rz" />
                                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ToolRz}" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Greifer (SMC MHZ2-16D über Magnetventil)" Width="330">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Label}" Text="Ausgang an der Platine" />
                                    <RadioButton Content="OUT1" Margin="6,3" IsChecked="{Binding GripperOutput, Converter={x:Static local:Converters.EqualsOne}, Mode=TwoWay}" />
                                    <RadioButton Content="OUT2" Margin="6,3" IsChecked="{Binding GripperOutput, Converter={x:Static local:Converters.EqualsTwo}, Mode=TwoWay}" />
                                </StackPanel>
                                <CheckBox Content="Ausgang HIGH = Greifer ZU" IsChecked="{Binding GripperClosedWhenHigh}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Jog-Geschwindigkeit bei 100 %" Width="330">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Linear (mm/s)" />
                                <TextBox Grid.Column="1" Text="{Binding JogLinear}" />
                                <TextBlock Style="{StaticResource Label}" Grid.Row="1" Text="Drehung (°/s)" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding JogAngular}" />
                                <TextBlock Style="{StaticResource Label}" Grid.Row="2" Text="Gelenke (°/s)" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding JogJoint}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="SpaceMouse" Width="330">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Totzone (%)" />
                                    <TextBox Grid.Column="1" Text="{Binding SmDeadband}" />
                                    <TextBlock Style="{StaticResource Label}" Grid.Row="1" Text="Kennlinie (1 = linear, 2 = fein)" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SmExponent}" />
                                </Grid>
                                <CheckBox Content="Translation" IsChecked="{Binding SmTranslation}" />
                                <CheckBox Content="Rotation" IsChecked="{Binding SmRotation}" />
                                <CheckBox Content="Nur stärkste Achse (dominante Achse)" IsChecked="{Binding SmDominant}" />
                                <TextBlock Text="Richtung umkehren:" Style="{StaticResource Label}" Margin="2,8,2,2" />
                                <UniformGrid Columns="3">
                                    <CheckBox Content="X" IsChecked="{Binding SmInvX}" />
                                    <CheckBox Content="Y" IsChecked="{Binding SmInvY}" />
                                    <CheckBox Content="Z" IsChecked="{Binding SmInvZ}" />
                                    <CheckBox Content="Rx" IsChecked="{Binding SmInvRx}" />
                                    <CheckBox Content="Ry" IsChecked="{Binding SmInvRy}" />
                                    <CheckBox Content="Rz" IsChecked="{Binding SmInvRz}" />
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>

                        <StackPanel Width="330" Margin="4">
                            <Button Content="Einstellungen speichern" Command="{Binding SaveSettingsCommand}" FontWeight="Bold" Height="40" />
                        </StackPanel>
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== Druckfarm ===================== -->
            <TabItem Header="  Druckfarm  ">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="4">
                        <Button Content="▶ Farm starten" Command="{Binding StartFarmCommand}" FontWeight="Bold" Background="#C8E6C9" Height="36" />
                        <Button Content="■ Farm anhalten" Command="{Binding StopFarmCommand}" FontWeight="Bold" Height="36" />
                        <Border Style="{StaticResource Lamp}" VerticalAlignment="Center" Background="{Binding FarmRunning, Converter={StaticResource OkBrush}}">
                            <TextBlock Style="{StaticResource LampText}" Text="Farm läuft" />
                        </Border>
                        <TextBlock VerticalAlignment="Center" Margin="10,0" Foreground="#555" TextWrapping="Wrap" MaxWidth="700"
                                   Text="Angehalten: keine neuen Drucke und keine automatische Entnahme. Laufende Drucke laufen weiter." />
                    </StackPanel>

                    <!-- Druckerübersicht -->
                    <GroupBox Grid.Row="1" Header="Drucker">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Bottom">
                                <Button Content="Platte ist leer" Command="{Binding ConfirmPlateEmptyCommand}" FontWeight="SemiBold" />
                                <Button Content="Jetzt abräumen (Roboter)" Command="{Binding RemoveNowCommand}" />
                                <Button Content="Fehler quittieren" Command="{Binding AcknowledgeFarmErrorCommand}" />
                                <Button Content="Bett-G-Code testen" Command="{Binding TestBedGcodeCommand}" />
                                <Button Content="Druck abbrechen" Command="{Binding StopPrintCommand}" Background="#FFCDD2" />
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding PrinterRows}" SelectedItem="{Binding SelectedPrinterRow}" AutoGenerateColumns="False"
                                      IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal" CanUserAddRows="False">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Background" Value="#FFEBEE" /></DataTrigger>
                                            <DataTrigger Binding="{Binding NeedsAction}" Value="True"><Setter Property="Background" Value="#FFF8E1" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Drucker" Binding="{Binding Name}" Width="110" />
                                    <DataGridTextColumn Header="Farm" Binding="{Binding State}" Width="120" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Drucker-Status" Binding="{Binding PrinterState}" Width="100" />
                                    <DataGridTextColumn Header="Bett" Binding="{Binding Bed}" Width="70" />
                                    <DataGridTextColumn Header="Auftrag" Binding="{Binding Job}" Width="150" />
                                    <DataGridTextColumn Header="Meldung" Binding="{Binding Message}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>

                    <!-- Aufträge -->
                    <GroupBox Grid.Row="2" Header="Aufträge (werden von oben nach unten abgearbeitet)">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Bottom" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Label}" Text="Platte" />
                                <TextBox Width="36" Text="{Binding NewJobPlate}" />
                                <TextBlock Style="{StaticResource Label}" Text="Stück" />
                                <TextBox Width="46" Text="{Binding NewJobQuantity}" />
                                <TextBlock Style="{StaticResource Label}" Text="Drucker" />
                                <ComboBox Width="150" Margin="3" ItemsSource="{Binding PrinterChoices}" SelectedItem="{Binding NewJobPrinter}" />
                                <CheckBox Content="AMS" IsChecked="{Binding NewJobUseAms}" />
                                <CheckBox Content="Bettnivellierung" IsChecked="{Binding NewJobBedLeveling}" />
                                <Button Content="＋ Datei hinzufügen…" Command="{Binding AddJobCommand}" FontWeight="SemiBold" />
                                <Button Content="▲" Command="{Binding JobUpCommand}" />
                                <Button Content="▼" Command="{Binding JobDownCommand}" />
                                <Button Content="Entfernen" Command="{Binding RemoveJobCommand}" />
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding JobRows}" SelectedItem="{Binding SelectedJob}" AutoGenerateColumns="False"
                                      IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Datei" Binding="{Binding FileName}" Width="*" />
                                    <DataGridTextColumn Header="Platte" Binding="{Binding Plate}" Width="55" />
                                    <DataGridTextColumn Header="Fertig" Binding="{Binding Progress}" Width="140" />
                                    <DataGridTextColumn Header="Drucker" Binding="{Binding Printer}" Width="110" />
                                    <DataGridTextColumn Header="Optionen" Binding="{Binding Options}" Width="190" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>

                    <!-- Druckereinstellungen -->
                    <GroupBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Header="Drucker einrichten">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Neu" Command="{Binding NewPrinterCommand}" />
                                    <ComboBox Margin="3" ItemsSource="{Binding PrinterConfigs}" SelectedItem="{Binding SelectedPrinterConfig}" DisplayMemberPath="Name" />
                                </DockPanel>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="135" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Name" />
                                    <TextBox Grid.Column="1" Text="{Binding EdName}" />
                                    <TextBlock Style="{StaticResource Label}" Grid.Row="1" Text="Modell" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="3" ItemsSource="{Binding PrinterKinds}" SelectedItem="{Binding EdKind}" />
                                    <TextBlock Style="{StaticResource Label}" Grid.Row="2" Text="IP-Adresse" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EdHost}" />
                                    <TextBlock Style="{StaticResource Label}" Grid.Row="3" Text="Seriennummer" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EdSerial}" />
                                    <TextBlock Style="{StaticResource Label}" Grid.Row="4" Text="Zugangscode (LAN)" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding EdAccessCode}" />
                                    <CheckBox Grid.Row="5" Grid.ColumnSpan="2" Content="Aktiv (in der Farm verwenden)" IsChecked="{Binding EdEnabled}" />
                                    <CheckBox Grid.Row="6" Grid.ColumnSpan="2" Content="Wird vom PAROL6 abgeräumt" IsChecked="{Binding EdHasRobot}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Label}" Grid.Row="7" Text="Entnahme-Programm" />
                                    <ComboBox Grid.Row="7" Grid.Column="1" Margin="3" ItemsSource="{Binding ProgramNames}" SelectedItem="{Binding EdRemovalProgram}"
                                              IsEnabled="{Binding EdHasRobot}" />
                                    <TextBlock Style="{StaticResource Label}" Grid.Row="8" Text="Release-Temp. (°C)" />
                                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding EdReleaseTemp}" />
                                    <TextBlock Style="{StaticResource Label}" Grid.Row="9" Text="Bett-G-Code" VerticalAlignment="Top" />
                                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding EdBedGcode}" AcceptsReturn="True" Height="60"
                                             FontFamily="Consolas" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                                    <TextBlock Style="{StaticResource Label}" Grid.Row="10" Text="Warten danach (s)" />
                                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding EdBedWait}" />
                                </Grid>
                                <UniformGrid Columns="2">
                                    <Button Content="Speichern &amp; verbinden" Command="{Binding SavePrinterCommand}" FontWeight="SemiBold" />
                                    <Button Content="Löschen" Command="{Binding DeletePrinterCommand}" />
                                </UniformGrid>
                                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="3,8">
                                    Am Drucker: LAN-Modus und Entwicklermodus einschalten. IP, Seriennummer und Zugangscode stehen im
                                    Netzwerk-Menü des Druckers. Die Daten bleiben nur auf diesem PC (%APPDATA%\ParolFarm\farm.json).
                                    Modell „Simulation“ testet die Farm ohne Drucker.
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
